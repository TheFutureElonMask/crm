APP_NAME="МФПО CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.kz

# Green API — console.green-api.com
GREEN_API_HOST=https://7103.api.greenapi.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=

# Three independent paid Green API instances, one per CRM manager.
# Manager email must exactly match the user's email in CRM.
# MANAGER_1 falls back to the legacy GREEN_API_* values above.
GREEN_API_MANAGER_1_EMAIL=manager1@example.com
GREEN_API_MANAGER_1_HOST=https://7103.api.greenapi.com
GREEN_API_MANAGER_1_ID_INSTANCE=
GREEN_API_MANAGER_1_TOKEN=

GREEN_API_MANAGER_2_EMAIL=manager2@example.com
GREEN_API_MANAGER_2_HOST=https://7103.api.greenapi.com
GREEN_API_MANAGER_2_ID_INSTANCE=
GREEN_API_MANAGER_2_TOKEN=

GREEN_API_MANAGER_3_EMAIL=manager3@example.com
GREEN_API_MANAGER_3_HOST=https://7103.api.greenapi.com
GREEN_API_MANAGER_3_ID_INSTANCE=
GREEN_API_MANAGER_3_TOKEN=

# Backward-compatible aliases. Можно не заполнять, если заполнены GREEN_API_* выше.
GREENAPI_BASE_URL=https://7103.api.greenapi.com
GREENAPI_INSTANCE_ID=
GREENAPI_TOKEN=
GREENAPI_VERIFY_SSL=true

# webhook на проде (polling не нужен)
GREEN_RECEIVE_MODE=webhook
WEBHOOK_PUBLIC_URL=https://your-domain.kz
BOT_DEBUG=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VERIFY_SSL=true
AI_TIMEOUT=15

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_system
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@mfpto.com"
MAIL_FROM_NAME="${APP_NAME}"
